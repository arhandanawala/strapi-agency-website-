# Strapi CMS Configuration
# Copy this file to .env and update with your Strapi credentials

# Your Strapi backend URL
VITE_STRAPI_URL=http://localhost:1337

# Your Strapi API Token (optional, for authenticated requests)
# Generate this in Strapi Admin > Settings > API Tokens
VITE_STRAPI_API_TOKEN=your_api_token_here
